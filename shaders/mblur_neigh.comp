#version 460
// Motion blur, step 2 (post_fx.cpp): each tile takes the largest velocity of its 3x3
// neighbourhood, so a fast object blurs out over the edge of its own tile.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D u_tile;   // point
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D o_neigh;
layout(push_constant) uniform PC { vec4 p; } pc;   // xy: tiles
void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    if (t.x >= int(pc.p.x) || t.y >= int(pc.p.y)) return;
    vec2 best = vec2(0.0);
    float bl = 0.0;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            vec2 v = texelFetch(u_tile, clamp(t + ivec2(x, y), ivec2(0), ivec2(pc.p.xy) - 1), 0).rg;
            float l = dot(v, v);
            if (l > bl) { bl = l; best = v; }
        }
    imageStore(o_neigh, t, vec4(best, 0.0, 0.0));
}
