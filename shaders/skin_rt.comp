#version 460

// Skins one soldier's ray-tracing mesh into a buffer of positions that its acceleration
// structure is rebuilt from every frame (body_rt.cpp). Same skinning as cube_skin.vert. The
// surface is pulled in a little along its normal: this mesh is a coarser level of detail than
// the one drawn, and where it would stick out of the drawn skin the body would shadow itself
// in blotches.

layout(local_size_x = 64) in;

struct V { float px, py, pz, nx, ny, nz, u, v; };          // a Vertex (mesh.h): 32 bytes

layout(set = 0, binding = 0, std430) readonly buffer Rest { V rest[]; };
// (bone0, bone1, bone2), (bone3, weight0, weight1), (weight2, weight3), packed as floats in a Vertex
layout(set = 0, binding = 1, std430) readonly buffer Skin { V skin[]; };
layout(set = 0, binding = 2, std430) readonly buffer BonePalette { vec4 bone_rows[]; };
layout(set = 0, binding = 3, std430) writeonly buffer Out { vec4 out_pos[]; };

layout(push_constant) uniform PC {
    uint  palette;      // the character's first row in the palette
    uint  count;        // vertices
    uint  dst;          // first vertex written
    float inset;        // metres
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    const V r = rest[i];
    const V s = skin[i];
    const float bone[4] = float[4](s.px, s.py, s.pz, s.nx);
    const float weight[4] = float[4](s.ny, s.nz, s.u, s.v);
    const vec4 p0 = vec4(r.px, r.py, r.pz, 1.0);
    const vec3 n0 = vec3(r.nx, r.ny, r.nz);
    vec3 p = vec3(0.0), n = vec3(0.0);
    for (int k = 0; k < 4; ++k) {
        const float w = weight[k];
        if (w <= 0.0) continue;
        const uint row = pc.palette + uint(bone[k] + 0.5) * 3u;
        const vec4 r0 = bone_rows[row], r1 = bone_rows[row + 1u], r2 = bone_rows[row + 2u];
        p += vec3(dot(r0, p0), dot(r1, p0), dot(r2, p0)) * w;
        n += vec3(dot(r0.xyz, n0), dot(r1.xyz, n0), dot(r2.xyz, n0)) * w;
    }
    const float nl = length(n);
    if (nl > 1e-5) p -= n * (pc.inset / nl);
    out_pos[pc.dst + i] = vec4(p, 1.0);
}
