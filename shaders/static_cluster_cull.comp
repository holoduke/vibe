#version 460
// Cluster LOD selection for the static world meshes (castle towers and
// roofs, the chapel, the gravestones) - vk_engine/cluster_draw.cpp.
// One thread per cluster: the same cut test as cluster_cull.comp (drawn when
// its own error is under the threshold on screen while its parent's is not),
// then view and occlusion culling by its own bounds. The meshes are in world
// space, so there is no instance transform. Drawn clusters are appended to
// their mesh part's command list.
layout(local_size_x = 64) in;

struct Cluster { vec4 bounds; vec4 self; vec4 parent; float self_error; float parent_error; uint first_index; uint index_count; };
layout(std430, set = 0, binding = 0) readonly buffer Clusters { Cluster cl[]; };
layout(std430, set = 0, binding = 1) readonly buffer Meta     { uvec4 meta[]; };   // per cluster: part, first command slot of the part, level (0 = finest)
layout(std430, set = 0, binding = 2) buffer Commands          { uint cmd[]; };     // [0..63] counts per part; commands (5 uints) from [64]
layout(set = 0, binding = 3) uniform sampler2D u_hiz;

layout(push_constant) uniform PC {
    vec4  planes[6];
    vec4  cam;        // .xyz eye, .w pixels per radian
    vec4  params;     // .x cluster count, .y error threshold (pixels), .z occlusion on (0/1)
    mat4  prev_vp;
    vec4  hiz;        // .xy pyramid level-0 size, .z mip count
    uvec4 loaded;     // bit per part: its finest level is on the GPU (streaming)
} pc;

bool occluded(vec3 c, float r, float d) {
    vec4 cc = pc.prev_vp * vec4(c, 1.0);
    if (cc.w <= r) return false;
    vec2 uv = (cc.xyz / cc.w).xy * 0.5 + 0.5;
    float r_uv = r / max(d, 0.1) * pc.cam.w / pc.hiz.y;
    vec2 lo = uv - vec2(r_uv * pc.hiz.y / pc.hiz.x, r_uv);
    vec2 hi = uv + vec2(r_uv * pc.hiz.y / pc.hiz.x, r_uv);
    if (!(lo.x > 0.02 && lo.y > 0.02 && hi.x < 0.98 && hi.y < 0.98)) return false;
    vec4 fc = pc.prev_vp * vec4(c + normalize(pc.cam.xyz - c) * r, 1.0);
    float zmin = fc.z / fc.w;
    vec2 ext = (hi - lo) * pc.hiz.xy;
    float mip = clamp(ceil(log2(max(max(ext.x, ext.y), 1.0))), 0.0, pc.hiz.z - 1.0);
    float z = textureLod(u_hiz, vec2(lo.x, lo.y), mip).r;
    z = max(z, textureLod(u_hiz, vec2(hi.x, lo.y), mip).r);
    z = max(z, textureLod(u_hiz, vec2(lo.x, hi.y), mip).r);
    z = max(z, textureLod(u_hiz, vec2(hi.x, hi.y), mip).r);
    return zmin > z + 1e-5;
}

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= uint(pc.params.x)) return;
    Cluster C = cl[j];
    float e_self = 0.0, e_parent = 1e30;
    if (C.self_error > 0.0)
        e_self = C.self_error / max(distance(C.self.xyz, pc.cam.xyz) - C.self.w, 0.05) * pc.cam.w;
    if (C.parent_error < 1e29)
        e_parent = C.parent_error / max(distance(C.parent.xyz, pc.cam.xyz) - C.parent.w, 0.05) * pc.cam.w;
    uvec4 m = meta[j];
    // Streaming: while a part's finest level is not loaded, level 1 stands in for it.
    bool fine_in = ((pc.loaded[m.x >> 5] >> (m.x & 31u)) & 1u) != 0u;
    if (m.z == 0u && !fine_in) return;
    bool stand_in = m.z == 1u && !fine_in;
    if (!((e_self <= pc.params.y || stand_in) && e_parent > pc.params.y)) return;

    vec3 bw = C.bounds.xyz; float br = C.bounds.w;
    for (int p = 0; p < 6; ++p)
        if (dot(pc.planes[p].xyz, bw) + pc.planes[p].w < -br) return;
    float bd = distance(bw, pc.cam.xyz);
    // (the castle is its own main occluder: only clusters well away from the eye,
    // so nothing is dropped while walking through a doorway)
    if (pc.params.z > 0.5 && bd > br + 12.0 && occluded(bw, br, bd)) return;

    uint n = atomicAdd(cmd[m.x], 1u);
    uint o = 64u + (m.y + n) * 5u;
    cmd[o]      = C.index_count;
    cmd[o + 1u] = 1u;
    cmd[o + 2u] = C.first_index;
    cmd[o + 3u] = 0u;
    cmd[o + 4u] = 0u;
}
