#version 460
// Glare sprites, step 1 (post_fx.cpp): find the light sources in the picture and append one
// sprite for each. A source is picked by what it IS, each kind with its own threshold on
// R + G + B against the adapted luminance L (the metered average), never by brightness alone -
// a sunlit wall seen from a dark room is bright against L and is no light:
//   - emissive surfaces (G-buffer material 5: lamp heads, lit windows, screens, the rocket's and
//     the pad's lights): T = max(8 L + 0.5, 2);
//   - glints: water (material 7), metal and glossy surfaces (roughness < 0.3) - the reference
//     game's threshold, (100 + 900 sat(L)) L (1 + 4 sat(dist / 200));
//   - the sun's disc (by day, where it is not hidden);
//   - other sky pixels far brighter than the sky round them can be (the glow drawn for a far lamp
//     or a car's lights against the night sky): T = 60 L + 2, never within 25 degrees of the sun;
//   - anything else (plain diffuse surfaces, plants, the ground): never.
// One thread per 8x8 block of the output: of 16 taps, the one furthest over its own threshold;
// a soft threshold (T .. 1.6T) and a per-block temporal hold (rises at once, fades over a few
// frames) so a light that sits near the threshold does not flicker. Up to 1000 sprites.

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D u_src;
layout(set = 0, binding = 1) uniform sampler2D u_depth;
#include "post_fx.glsl"
layout(std430, set = 0, binding = 2) readonly buffer PostFxB { PostFxData d; } pfx;
struct Sprite { vec4 pos; vec4 col; };   // pos: xy pixel, z radius (px), w weight; col: rgb chroma, w brightness
layout(std430, set = 0, binding = 3) buffer Sprites {
    uint vertex_count, instance_count, first_vertex, first_instance;   // the indirect draw
    Sprite s[];
} spr;
layout(set = 0, binding = 4, r16f) uniform image2D u_hold;
layout(set = 0, binding = 5) uniform sampler2D u_gbuf0;   // albedo, a: material id (render resolution, point)
layout(set = 0, binding = 6) uniform sampler2D u_gbuf1;   // normal, b: roughness, a: flags (metal 0.5 .. 0.83)

layout(push_constant) uniform PC { vec4 p; } pc;   // xy: blocks, zw: output size

const uint kMaxSprites = 1000u;

// The threshold for the source at uv (1e9: not a light source).
float source_threshold(vec2 uv, float L) {
    float dz = textureLod(u_depth, uv, 0.0).r;
    vec4 wf = pfx.d.cur_rot_ivp * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 dir = normalize(wf.xyz / wf.w);
    float sun_c = dot(dir, pfx.d.sun_d.xyz);
    if (dz >= 0.99999) {
        if (pfx.d.sun_d.w > 0.5) {
            if (sun_c > 0.99995) return 4.0 * L + 1.0;          // the sun's disc (about its radius)
            if (sun_c > 0.906) return 1e9;                       // (the bright sky round the sun)
        }
        return 60.0 * L + 2.0;
    }
    vec4 g0 = textureLod(u_gbuf0, uv, 0.0);
    vec4 g1 = textureLod(u_gbuf1, uv, 0.0);
    int mat = int(g0.a * 255.0 + 0.5);
    if (mat == 5) return max(8.0 * L + 0.5, 2.0);      // (2: over what a self-lit picture - stained glass, a screen - reaches)
    bool metal = g1.a > 0.5 && g1.a < 0.83;
    bool glossy = (mat == 1 && g1.b < 0.3) || metal || mat == 7;
    if (glossy) {
        float dist = pfx_lin_depth(pfx.d, dz);
        return (100.0 + 900.0 * clamp(L, 0.0, 1.0)) * L * (1.0 + 4.0 * clamp(dist / 200.0, 0.0, 1.0));
    }
    return 1e9;
}

void main() {
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    if (b.x >= int(pc.p.x) || b.y >= int(pc.p.y)) return;
    vec2 inv = 1.0 / pc.p.zw;
    float L = max(pfx.d.avg, 1e-4);
    float best_r = 0.0, best = 0.0, bT = 1e9;
    vec2 buv = vec2(0.0);
    vec3 bc = vec3(0.0);
    for (int y = 0; y < 4; ++y)
        for (int x = 0; x < 4; ++x) {
            vec2 uv = (vec2(b * 8) + vec2(x, y) * 2.0 + 1.0) * inv;
            vec3 c = textureLod(u_src, uv, 0.0).rgb;
            float v = c.r + c.g + c.b;
            if (!(v == v)) continue;
            float T = source_threshold(uv, L) * pfx.d.glare.y;
            float r = v / T;
            if (r > best_r) { best_r = r; best = v; buv = uv; bc = c; bT = T; }
        }
    float w = (bT < 1e8) ? smoothstep(bT, 1.6 * bT, best) : 0.0;
    float h = imageLoad(u_hold, b).r;
    h = (w > h) ? w : mix(h, w, 0.3);
    imageStore(u_hold, b, vec4(h));
    if (h < 0.02 || bT > 1e8) return;
    uint i = atomicAdd(spr.instance_count, 1u);
    if (i >= kMaxSprites) return;
    float size = clamp(0.6 * sqrt(best / bT), 1.0, 4.0);      // further over its threshold: bigger
    float rad = min(pfx.d.glare.z, 40.0 * size) * (pc.p.w / 1080.0);
    spr.s[i].pos = vec4(buv * pc.p.zw, rad, h);
    // (brightness capped at six thresholds: a glint of the sun is not a searchlight)
    spr.s[i].col = vec4(bc / max(best, 1e-4), clamp(best, 2.0 * bT, 6.0 * bT));   // (at least two thresholds: a source just over it still shows)
}
