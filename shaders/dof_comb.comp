#version 460
// Depth of field, step 3 (post_fx.cpp): back to full resolution. The far field replaces the
// sharp colour as this pixel's own circle grows past a pixel; the near field lies over it by
// its coverage.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D u_src;      // HDR colour (full)
layout(set = 0, binding = 1) uniform sampler2D u_far;      // half: rgb, a: signed radius
layout(set = 0, binding = 2) uniform sampler2D u_near;     // half: rgb, a: coverage
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D o_dst;
layout(push_constant) uniform PC { vec4 p; } pc;   // xy: output size
void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(pc.p.x) || ip.y >= int(pc.p.y)) return;
    vec2 uv = (vec2(ip) + 0.5) / pc.p.xy;
    vec4 c = textureLod(u_src, uv, 0.0);
    vec4 f = textureLod(u_far, uv, 0.0);
    vec4 n = textureLod(u_near, uv, 0.0);
    vec3 o = mix(c.rgb, f.rgb, clamp(f.a * 2.0 - 0.5, 0.0, 1.0));   // (radius in half pixels)
    o = mix(o, n.rgb, n.a);
    imageStore(o_dst, ip, vec4(o, c.a));
}
