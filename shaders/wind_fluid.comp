#version 460
// The wind field round the camera: a small fluid simulation on a 3D grid, the air that
// people and cars stir up, which the grass then follows. the reference game's "wind fluid" (its
// interaction shader AdvectVelocityCS, AddForceCS, ComputeCurlCS, ComputeVorticityConfinementCS,
// ComputePressureCS, ComputeGradientCS, ComputeAccumulationCS, read from the compiled shaders;
// this is our own code for it, formula for formula). vk_engine/wind_fluid.cpp runs the passes;
// tuft_cd.glsl reads the result.
//
// The grid: N cells a side of c metres, centred on the camera and moved with it in whole
// cells. Velocity is in metres per 1/30 s. One dispatch = one pass (pc.mode):
//   0 advect      the field is shifted by the cells the camera moved, carried along itself
//                 (semi-Lagrangian) and damped by 0.995
//   1 forces      up to 20 of them, each exp(-r^2 / radius) * power: along a direction,
//                 outward, a vortex about the vertical or about an axis, the two "swirl-in"
//                 kinds, or a scalar (kept in .w, which falls off by 700 a second)
//   2 curl        half the curl of the velocity, and its length
//   3 confinement the swirls are tightened: velocity += cross(direction of the gradient of
//                 the curl's length, curl) * saturate((|gradient| - 0.025) * 30 dt)
//   4 pressure    one Jacobi step: p' = (sum of the six neighbours - divergence) / 6
//   5 gradient    velocity -= half the pressure difference across the cell
//   6 history     history = lerp(history shifted like the field, velocity, saturate(2 dt)):
//                 what the plants read, so they do not twitch
// A neighbour outside the grid reads as the edge cell (the game's only boundary rule); what
// is shifted in from outside reads as still air.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) uniform sampler3D s_v0;
layout(set = 0, binding = 1) uniform sampler3D s_v1;
layout(set = 0, binding = 2) uniform sampler3D s_p0;
layout(set = 0, binding = 3) uniform sampler3D s_p1;
layout(set = 0, binding = 4) uniform sampler3D s_curl;
layout(set = 0, binding = 5) uniform sampler3D s_hist;        // (unused: the plants' picture)
layout(set = 0, binding = 6) uniform sampler3D s_hist_prev;
layout(set = 0, binding = 7,  rgba16f) uniform writeonly image3D o_v0;
layout(set = 0, binding = 8,  rgba16f) uniform writeonly image3D o_v1;
layout(set = 0, binding = 9,  rgba16f) uniform writeonly image3D o_p0;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image3D o_p1;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image3D o_curl;
layout(set = 0, binding = 12, rgba16f) uniform writeonly image3D o_hist;
layout(std140, set = 0, binding = 14) uniform Forces {
    vec4 f_pos_power[20];      // xyz = world position, w = power
    vec4 f_dir_radius[20];     // xyz = direction, w = radius (divides the distance SQUARED)
    vec4 f_type[20];           // x = kind (0..6)
};

layout(push_constant) uniform PC {
    vec4  cam;      // xyz = the camera, w = dt (s)
    vec4  grid;     // x = N, y = c (m), z = forces in use, w = mode
    ivec4 shift;    // xyz = cells the camera moved since last frame, w = pressure: 0 reads p0, 1 reads p1
} pc;

ivec3 g_lim;
vec4 at(sampler3D s, ivec3 i) { return texelFetch(s, clamp(i, ivec3(0), g_lim), 0); }                 // edge cell beyond the grid
vec4 at0(sampler3D s, ivec3 i) {                                                                       // still air beyond the grid
    return any(lessThan(i, ivec3(0))) || any(greaterThan(i, g_lim)) ? vec4(0.0) : texelFetch(s, i, 0);
}

void main() {
    ivec3 i = ivec3(gl_GlobalInvocationID);
    int   N = int(pc.grid.x);
    if (any(greaterThanEqual(i, ivec3(N)))) return;
    g_lim = ivec3(N - 1);
    float c  = pc.grid.y, dt = pc.cam.w;
    int   mode = int(pc.grid.w + 0.5);
    const ivec3 X = ivec3(1, 0, 0), Y = ivec3(0, 1, 0), Z = ivec3(0, 0, 1);

    if (mode == 0) {                                   // ---- advect: v0 -> v1 ----
        vec3 p  = vec3(i) + 0.5 + vec3(pc.shift.xyz);
        vec3 v0 = at0(s_v0, i + pc.shift.xyz).xyz;
        vec3 q  = p - v0 * (dt * 30.0) / c;
        // (s_v0's sampler: trilinear, black beyond the edge)
        vec3 v  = textureLod(s_v0, q / float(N), 0.0).xyz * 0.995;
        imageStore(o_v1, i, vec4(v, texelFetch(s_v0, i, 0).w));
    } else if (mode == 1) {                            // ---- forces: v1 -> v0 ----
        vec4 vel = texelFetch(s_v1, i, 0);
        vec3 v = vel.xyz;
        float w = max(vel.w - dt * 700.0, 0.0);
        vec3 P = (vec3(i) + 0.5 - 0.5 * float(N)) * c;                 // the cell's middle from the grid's
        int n = min(int(pc.grid.z + 0.5), 20);
        for (int k = 0; k < n; ++k) {
            vec3  F  = c * (floor(f_pos_power[k].xyz / c) - floor(pc.cam.xyz / c));
            vec3  D  = normalize(f_dir_radius[k].xyz + vec3(0.0, 1e-6, 0.0));
            float R  = max(f_dir_radius[k].w, 1e-3), Pw = f_pos_power[k].w;
            vec3  d  = P - F;
            float r2 = dot(d, d), g = exp(-r2 / R);
            vec3  dn = r2 > 1e-8 ? d * inversesqrt(r2) : vec3(0.0);
            int   ty = int(f_type[k].x + 0.5);
            if (ty == 0)      v += D * (g * Pw);
            else if (ty == 1) v += dn * (g * Pw);
            else if (ty == 2) { v.x += dn.z * g * Pw; v.z -= dn.x * g * Pw; }
            else if (ty == 3) {
                vec3 nn = -dn, h = vec3(nn.x, 0.0, nn.z);
                h = dot(h, h) > 1e-8 ? normalize(h) : vec3(0.0);
                vec3 t = 1.5 * h + sign(Pw) * vec3(nn.z, 0.0, -nn.x);
                if (dot(t, t) > 1e-8) v += normalize(t) * (abs(Pw) * exp(-r2 / (2.0 * R)));
            }
            else if (ty == 4) v += cross(D, dn) * (g * Pw);
            else if (ty == 5) {
                vec3 nn = -dn, h = nn - dot(nn, D) * D;
                h = dot(h, h) > 1e-8 ? normalize(h) : vec3(0.0);
                vec3 t = 1.5 * h + sign(Pw) * cross(D, nn);
                if (dot(t, t) > 1e-8) v += normalize(t) * (abs(Pw) * exp(-r2 / (2.0 * R)));
            }
            else if (ty == 6) w += g * Pw;
        }
        imageStore(o_v0, i, vec4(v, w));
    } else if (mode == 2) {                            // ---- curl: v0 -> curl ----
        vec3 L = at(s_v0, i - X).xyz, R = at(s_v0, i + X).xyz;
        vec3 D = at(s_v0, i - Y).xyz, U = at(s_v0, i + Y).xyz;
        vec3 B = at(s_v0, i - Z).xyz, F = at(s_v0, i + Z).xyz;
        vec3 w = 0.5 * vec3((U.z - D.z) - (F.y - B.y), (F.x - B.x) - (R.z - L.z), (R.y - L.y) - (U.x - D.x));
        imageStore(o_curl, i, vec4(w, length(w)));
    } else if (mode == 3) {                            // ---- confinement: v0, curl -> v1 ----
        vec4 vel = texelFetch(s_v0, i, 0);
        vec4 w   = texelFetch(s_curl, i, 0);
        vec3 G = 0.5 * vec3(abs(at(s_curl, i + X).w) - abs(at(s_curl, i - X).w),
                            abs(at(s_curl, i + Y).w) - abs(at(s_curl, i - Y).w),
                            abs(at(s_curl, i + Z).w) - abs(at(s_curl, i - Z).w));
        float m = length(G);
        vec3  Nn = m > 0.001 ? G / m : G;
        float k = clamp((m - 0.025) * 30.0 * dt, 0.0, 1.0);
        // (the game writes the curl's length into .w here; ours keeps the forces' scalar, which
        // nothing of ours reads yet)
        imageStore(o_v1, i, vec4(vel.xyz + cross(Nn, w.xyz) * k, vel.w));
    } else if (mode == 4) {                            // ---- pressure: v1, p(a) -> p(b) ----
        vec3 L = at(s_v1, i - X).xyz, R = at(s_v1, i + X).xyz;
        vec3 D = at(s_v1, i - Y).xyz, U = at(s_v1, i + Y).xyz;
        vec3 B = at(s_v1, i - Z).xyz, F = at(s_v1, i + Z).xyz;
        float div = 0.5 * ((R.x - L.x) + (U.y - D.y) + (F.z - B.z));
        float p;
        if (pc.shift.w == 0) {
            p = (at(s_p0, i - X).x + at(s_p0, i + X).x + at(s_p0, i - Y).x + at(s_p0, i + Y).x + at(s_p0, i - Z).x + at(s_p0, i + Z).x - div) * 0.1666667;
            imageStore(o_p1, i, vec4(p, 0.0, 0.0, 0.0));
        } else {
            p = (at(s_p1, i - X).x + at(s_p1, i + X).x + at(s_p1, i - Y).x + at(s_p1, i + Y).x + at(s_p1, i - Z).x + at(s_p1, i + Z).x - div) * 0.1666667;
            imageStore(o_p0, i, vec4(p, 0.0, 0.0, 0.0));
        }
    } else if (mode == 5) {                            // ---- gradient: v1, p0 -> v0 ----
        vec4 vel = texelFetch(s_v1, i, 0);
        vec3 gp = 0.5 * vec3(at(s_p0, i + X).x - at(s_p0, i - X).x, at(s_p0, i + Y).x - at(s_p0, i - Y).x, at(s_p0, i + Z).x - at(s_p0, i - Z).x);
        imageStore(o_v0, i, vec4(vel.xyz - gp, vel.w));
    } else {                                           // ---- history: v0, last history -> history ----
        vec4 h = at0(s_hist_prev, i + pc.shift.xyz);
        vec4 v = texelFetch(s_v0, i, 0);
        imageStore(o_hist, i, mix(h, v, clamp(dt * 2.0, 0.0, 1.0)));
    }
}
